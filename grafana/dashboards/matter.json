          "rawSql": "SELECT time, sensor, air_quality FROM (SELECT DISTINCT ON (a.node_id) a.ts AS time, COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || a.node_id) AS sensor, (a.value::text)::numeric AS air_quality FROM attribute_updates a LEFT JOIN matter_nodes n ON n.node_id = a.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE a.attribute_path = '1/91/0' AND $__timeFilter(a.ts) ORDER BY a.node_id, a.ts DESC) latest ORDER BY time"
