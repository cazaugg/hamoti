    {
      "type": "row",
      "title": "System",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Node availability",
      "id": 12,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT e.ts AS time, COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || e.node_id) AS sensor, CASE WHEN (e.data->>'available')::boolean THEN 1 ELSE 0 END AS available FROM events e LEFT JOIN matter_nodes n ON n.node_id = e.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE e.event_type = 'node_updated' AND e.data ? 'available' AND $__timeFilter(e.ts) ORDER BY e.ts"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest rate (updates / 5 min)",
      "id": 13,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(ts, '5m'), COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || a.node_id) AS sensor, count(*) AS updates FROM attribute_updates a LEFT JOIN matter_nodes n ON n.node_id = a.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE $__timeFilter(a.ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "type": "table",
      "title": "Node inventory",
      "id": 14,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT node_id AS node, nn.custom_name AS name, label, product_name AS product, vendor_name AS vendor, unique_id, identity_source AS identity, available, date_commissioned AS commissioned, last_interview AS interviewed FROM matter_nodes n LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid ORDER BY node_id"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent events",
      "id": 15,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT e.ts AS time, e.event_type AS event, COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || e.node_id) AS node_name, e.node_id, left(e.data::text, 200) AS data FROM events e LEFT JOIN matter_nodes n ON n.node_id = e.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ]
    }
  ]
