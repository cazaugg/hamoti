    {
      "type": "timeseries",
      "title": "Node availability",
      "id": 12,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT e.time, COALESCE(s.sensor, 'node ' || e.node_id) AS sensor, CASE WHEN (e.data->>'available')::boolean THEN 1 ELSE 0 END AS available FROM events e LEFT JOIN matter_sensors s ON s.node_id = e.node_id WHERE e.event_type = 'node_updated' AND e.data ? 'available' AND COALESCE(s.sensor, 'node ' || e.node_id) IN ($sensor) AND $__timeFilter(e.time) ORDER BY e.time"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest rate (updates / 5 min)",
      "id": 13,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(a.time, '5m'), COALESCE(s.sensor, 'node ' || a.node_id) AS sensor, count(*) AS updates FROM attribute_updates a LEFT JOIN matter_sensors s ON s.node_id = a.node_id WHERE COALESCE(s.sensor, 'node ' || a.node_id) IN ($sensor) AND $__timeFilter(a.time) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "type": "table",
      "title": "Node inventory",
      "id": 14,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT node_id AS node, custom_name AS name, label, product, vendor, unique_id, identity_source AS identity, available, date_commissioned AS commissioned, last_interview AS interviewed FROM matter_sensors WHERE sensor IN ($sensor) ORDER BY node_id"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent events",
      "id": 15,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT e.time, e.event_type AS event, COALESCE(s.sensor, 'node ' || e.node_id) AS node_name, e.node_id, left(e.data::text, 200) AS data FROM events e LEFT JOIN matter_sensors s ON s.node_id = e.node_id WHERE $__timeFilter(e.time) AND COALESCE(s.sensor, 'node ' || e.node_id) IN ($sensor) ORDER BY e.time DESC LIMIT 50"
        }
      ]
    }
