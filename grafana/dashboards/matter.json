      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT a.ts AS time, COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || a.node_id) AS sensor, (a.value::text)::numeric / 100 AS humidity FROM attribute_updates a LEFT JOIN matter_nodes n ON n.node_id = a.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE a.attribute_path IN ('1/1029/0', '2/1029/0') AND $__timeFilter(a.ts) ORDER BY a.ts"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Current temperature",
      "id": 4,
      "datasource": { "type": "postgres", "uid": "matter-timescale" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "matter-timescale" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT time, sensor, temperature FROM (SELECT DISTINCT ON (a.node_id) a.ts AS time, COALESCE(NULLIF(nn.custom_name, ''), NULLIF(n.label, ''), 'node ' || a.node_id) AS sensor, (a.value::text)::numeric / 100 AS temperature FROM attribute_updates a LEFT JOIN matter_nodes n ON n.node_id = a.node_id LEFT JOIN node_names nn ON nn.device_uuid = n.device_uuid WHERE a.attribute_path = '1/1026/0' AND $__timeFilter(a.ts) ORDER BY a.node_id, a.ts DESC) latest ORDER BY time"
        }
      ]
    },
